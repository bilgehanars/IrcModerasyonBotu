[Unit]
Description=Bilgehan IRC Moderasyon Botu
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ircmod
Group=ircmod
WorkingDirectory=/opt/IrcModerasyonBotu
ExecStart=/opt/IrcModerasyonBotu/ircmoderasyonbotu -config /opt/IrcModerasyonBotu/bilgehan.conf
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/IrcModerasyonBotu

[Install]
WantedBy=multi-user.target
